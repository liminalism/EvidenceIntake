record evidence-intake-project.papercut.driving-the-winsafe-gui-for-verification-via/1 : papercut {
    title "Driving the WinSafe GUI for verification via PowerShell SendKeys…"
    state verified
    statement """
        Driving the WinSafe GUI for verification via PowerShell SendKeys misfired: SetForegroundWindow from a background process is ignored by the Windows foreground lock, so keystrokes went to whatever app the user had focused. Any future GUI-driving script must verify GetForegroundWindow equals the target window before EVERY key send and abort otherwise; better, verify through headless Workspace tests and leave live-GUI passes to a human.
        """
    observed_at git:15f84a997f9c9c108341d58335ed1f04853861f2
    author "claude"
    created_at 2026-08-30
}


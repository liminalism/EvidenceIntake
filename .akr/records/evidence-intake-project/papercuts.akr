record evidence-intake-project.papercut.while-inspecting-a-sibling-crate-i-tried-cargo/1 : papercut {
    title "While inspecting a sibling crate I tried `cargo metadata --no-deps…"
    state verified
    statement """
        While inspecting a sibling crate I tried `cargo metadata --no-deps --format-version 1 -p lege-gpu`, but cargo metadata does not support package selection even though many cargo subcommands do. The command had to be retried without `-p` or replaced with manifest inspection.
        """
    observed_at git:0a17a5d442e4980045b2c220208df090f77a937f

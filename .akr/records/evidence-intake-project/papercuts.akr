record evidence-intake-project.papercut.rerunning-the-two-minute-video-describe-command/1 : papercut {
    title "Rerunning the two-minute video describe command exposed two non-obvious…"
    state verified
    statement """
        Rerunning the two-minute video describe command exposed two non-obvious Windows failures: the CLI main thread overflowed its default stack while constructing/dropping a 27-source normalized batch, and ffmpeg could not resolve relative input/stills paths after the sampler changed its child working directory for metadata output. The CLI now runs on an explicit 8 MiB worker stack and resolves those paths before launching ffmpeg.
        """
    observed_at git:0a17a5d442e4980045b2c220208df090f77a937f
    author "codex"
    created_at 2026-08-20
}


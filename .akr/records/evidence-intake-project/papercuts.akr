akr 0.1
project evidence-intake-project

record evidence-intake-project.papercut.a-final-ripgrep-line-number-lookup-embedded-a/1 : papercut {
    title "A final ripgrep line-number lookup embedded a double-quoted regex…"
    state verified
    statement """
        A final ripgrep line-number lookup embedded a double-quoted regex inside a double-quoted PowerShell command, so the quotes were consumed and rg reported an unclosed group; single-quote regex literals in PowerShell.
        """
    observed_at git:a346f4cfdef94e0f0874cb937583c0e064468c0b
    author "codex"
    created_at 2026-08-09
}

record evidence-intake-project.papercut.a-recursive-api-scan-used-the-common-unix-style/1 : papercut {
    title "A recursive API scan used the common Unix-style 'rg ... src/*.rs' form,…"
    state verified
    statement """
        A recursive API scan used the common Unix-style 'rg ... src/*.rs' form, but PowerShell passed the glob literally and ripgrep rejected it; use 'rg ... src -g *.rs' on this Windows workspace.
        """
    observed_at git:a346f4cfdef94e0f0874cb937583c0e064468c0b
    author "codex"
    created_at 2026-08-09
}


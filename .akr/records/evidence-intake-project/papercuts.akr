record evidence-intake-project.papercut.video-transcriber-mcp-looks-like-a-reusable/1 : papercut {
    title "video-transcriber-mcp looks like a reusable Whisper crate on lib.rs but…"
    state verified
    statement """
        video-transcriber-mcp looks like a reusable Whisper crate on lib.rs but it is an MCP/YouTube downloader (yt-dlp, axum, REMOTE_WHISPER_URL). The reusable engine is whisper-rs. Putting whisper-rs behind a Cargo feature still gets compiled by the repo's cargo clippy --all-features.
        """
    observed_at git:aa07b628e8b4d3c7153ced96e0d9f1e08f5aa53c
    author "grok"
    created_at 2026-08-14
}

akr 0.1
project evidence-intake-project

record evidence-intake-project.assisted.deterministic-analyzers/1 : work {
    title "Deterministic assisted collation"
    state completed
    scope [
        path "docs/suggestions.md",
        path "src/main.rs",
        path "src/store.rs",
        path "src/suggest.rs",
        path "tests/suggest.rs"
    ]
    intent """
        Open Phase D with three deterministic analyzers over the existing graph — temporal overlap across lanes, contradiction candidates, and conflicting attribution — each proposing an edge that enters `suggested` and waits for a named person. Establish the mechanism so later analyzers are one enum variant plus one query.
        """
    claim already-held-is-direction-blind {
        text """
            An analyzer points at a pair, not an orientation. The unique index on edges only sees one orientation, so the skip check queries both. This was found in practice: conflicting-attribution proposed `content-passenger-first impeaches content-passenger-later` while the vehicle-stop fixture already held the human-authored `edge-patel-impeach` in the opposite direction. Without the bidirectional check the analyzer would ask a reviewer to answer a question a person had already answered.
            """
    }
    claim analyzers-touch-nothing-else {
        text """
            A test snapshots every review state before and after a run and asserts the only difference is the added suggestions, that the review trail stays empty because no decision was made, and that nothing was merged.
            """
    }
    claim pair-matching-is-independent-of-id-order {
        text """
            The first contradiction-candidate query tied 'which excerpt supports' to 'which identifier sorts first' and therefore found nothing in the vehicle-stop fixture, where the contradicting excerpt sorts first. Pairs are now matched on their relations and only then ordered with MIN/MAX for a stable edge direction. Determinism of direction and correctness of matching are separate concerns.
            """
    }
    claim review-queue-now-recognises-proposed-edges {
        text """
            review_queue hardcoded machine_generated = 0 and extractor = NULL for every edge, which was true only while edges could not be machine-authored. It now derives both from the `suggest:` prefix on created_by, so proposals sort ahead of hand-entered work and name the analyzer that made them.
            """
    }
    claim rules-not-models {
        text """
            Analyzers are interval arithmetic and joins over data the case already holds. No model, no confidence, no score — deliberately twice over: a suggestion a defender cannot reconstruct is one they cannot argue with, and a number attached to a proposal would be read as a probability that it is true, which is the judgment this kernel refuses to make. Every proposal carries a rationale stating the deterministic ground in full, and a test asserts no rationale contains scoring language.
            """
    }
}

record evidence-intake-project.assisted.findings-and-remaining-analyzers/1 : work {
    title "Findings, duplicate people, and entity authoring"
    state completed
    scope [
        path "src/authoring.rs",
        path "src/main.rs",
        path "src/model.rs",
        path "src/store.rs",
        path "src/suggest.rs",
        path "tests/authoring.rs",
        path "tests/suggest.rs"
    ]
    intent """
        Complete the Phase D analyzer set. Several remaining items — referenced-but-missing evidence, candidate links to charges, temporal alignment — are gaps rather than proposable claims, so the suggestion mechanism needed a second output shape before they could be built at all.
        """
    claim duplicate-people-rule-is-narrow-on-purpose {
        text """
            Two people are a candidate when every part of one name appears in the other after folding case and punctuation: `Patel` matches `Jordan Patel`. `J. Patel` does not match `Jordan Patel`, because expanding an initial is a guess that would tie `J. Patel` to `Jane Patel` just as confidently. Only entities of kind `person` are compared — `possibly_same_person` would be the wrong claim to make about two vehicles. Comparison is in Rust rather than SQL so a defender can read the rule.
            """
    }
    claim entity-authoring-was-a-gap {
        text """
            Entities could only come from fixtures, so the mutation API previously described as complete was not. `Store::record_entity` closes it and deliberately permits a name already in use: refusing the second write would answer, by merging, the exact question rule 7 insists a person answers. The duplicate-entity analyzer then raises that question.
            """
    }
    claim no-tolerance-windows {
        text """
            clock-disagreement reports that two sources place one proposition at different times, with no threshold. How much disagreement matters is the defender's judgment; a tolerance window here would quietly make it the tool's.
            """
    }
    claim proposal-versus-finding {
        text """
            A proposal is a claim that needs a decision, so it is written as a `suggested` edge and joins the review queue. A finding is a gap that needs work — a proposition tied to no element is not something a reviewer can disagree with. Findings are derived every run and stored nowhere, so closing the gap is the only dismissal one needs; there is no dismissal state to design, no stale-dismissal problem, and no way for a closed gap to keep nagging. An analyzer does one job or the other, never both.
            """
    }
}

record evidence-intake-project.mutation-api.element-mapping/1 : work {
    title "Charge recording and element mapping"
    state completed
    scope [
        path "migrations/**",
        path "src/authoring.rs",
        path "src/main.rs",
        path "src/model.rs",
        path "src/store.rs",
        path "src/views.rs",
        path "tests/authoring.rs"
    ]
    intent """
        Let a person record a charge with its statutory elements and map propositions onto those elements, completing the element-by-element workspace the element matrix and offense comparison already render. Fix three defects found in the surrounding read paths while doing it.
        """
    claim assessment-is-a-direction {
        text """
            An element assessment records a direction, not a weight: supports, opposes, uncertain, excluded, never aggregated. `uncertain` is a first-class answer for contested material rather than an unfinished one.
            """
    }
    claim case-boundaries-hold-in-views {
        text """
            element_links carries no case column, and element_matrix and offense_comparison joined propositions without constraining case_id. A row reaching another case's proposition would have surfaced that case's material in this one's workspace. Both queries now constrain it, independently of the mutation's own check.
            """
    }
    claim charge-with-its-elements {
        text """
            A charge is written with at least one element, in one transaction, with ordinals assigned from the given order. Every question a defender asks of a charge is element-by-element, so a charge with no elements cannot be reasoned about, and a gap in the ordinals would be a transcription error.
            """
    }
    claim element-mappings-name-their-author {
        text """
            element_links was the only record a person writes that carried no author. The column is added by Store::add_column_if_missing because SQLite has no re-runnable ALTER TABLE ADD COLUMN, is nullable because NOT NULL cannot be retrofitted, and is enforced forward by a trigger. Pre-existing rows keep a null author rather than being backfilled with a name nobody stood behind.
            """
    }
    claim one-direction-per-proposition {
        text """
            One proposition bears on one element in one direction. The original UNIQUE(element_id, proposition_id, assessment) permitted the same proposition to be filed under an element as both supports and opposes, which is contradictory rather than richer; a unique index on (element_id, proposition_id) closes it.
            """
    }
}

record evidence-intake-project.mutation-api.proposition-authoring/1 : work {
    title "Proposition authoring and evidence linking"
    state completed
    scope [
        path "migrations/**",
        path "src/authoring.rs",
        path "src/main.rs",
        path "src/model.rs",
        path "src/store.rs",
        path "tests/authoring.rs"
    ]
    intent """
        Give a defender the two mutations the kernel still lacks: writing down a contested proposition, and connecting source-grounded content to it with a typed, reasoned relationship. Until now the only mutations were import_normalized (adapter ingest) and apply_review (human decisions), so the central object of the collation thesis was read-only.
        """
    claim authoring-cannot-settle-a-proposition {
        text """
            An authored proposition is always `contested`. `undisputed` is a conclusion about the state of the evidence and is not available at authoring time, because nothing in the kernel is scored.
            """
    }
    claim authoring-is-not-review {
        text """
            Authoring a proposition or a link enters `unreviewed`. Writing something down is not evidence that anyone checked it, so authoring cannot produce `reviewed`, `verified`, or a machine `suggested` state.
            """
    }
    claim endpoints-must-exist-in-the-case {
        text """
            Both endpoints of a link must already exist and belong to the same case. An unknown identifier is refused rather than silently creating a node, and a link may not reach across a case boundary.
            """
    }
    claim link-carries-a-rationale {
        text """
            A link is required to carry a non-empty written rationale. An edge spans sources and has no single original, so the written reason is the only thing a later reader can weigh — the same standard apply_review imposes when verifying one.
            """
    }
}

record evidence-intake-project.mutation-api.versioned-work-product/1 : work {
    title "Versioned privileged work product"
    state completed
    scope [
        path "migrations/**",
        path "src/authoring.rs",
        path "src/fixture.rs",
        path "src/main.rs",
        path "src/store.rs",
        path "tests/work_product.rs"
    ]
    intent """
        Complete the backend mutation API with the privileged layer: advocacy items, annotations, and decision briefs, all versioned by superseding rather than overwriting. Annotations had a table, a supersedes column, and no read path or write path at all. Also fix the issue workspace, which listed every open task in the case under every issue.
        """
    claim orphan-tasks-are-invisible-in-workspaces {
        text """
            A task linked to no issue is counted in overview.open_advocacy_items but appears under no workspace. This is a known consequence of scoping tasks to their issue, documented rather than hidden.
            """
    }
    claim supersede-never-overwrite {
        text """
            Work product is revised by writing a new version that names the one it replaces. An earlier reading of an issue is what the attorney thought when they made a decision, so it stays readable. Only the current version may be revised: two revisions of the same version would fork the history and leave no single current reading.
            """
    }
    claim tasks-belong-to-their-issue {
        text """
            An issue workspace carries the investigation tasks linked to that issue by a requires_follow_up edge, not every open task in the case. The previous query returned identical case-wide lists under every issue, sending a defender reading one workspace to chase work belonging to an unrelated question. Follow-up edges are excluded from linked_material so the same task is not listed twice under two headings.
            """
    }
    claim views-filter-superseded {
        text """
            Every view over work product filters superseded rows. A rewritten issue that appeared twice in the workspace would read as two competing issues rather than one changed reading.
            """
    }
    claim work-product-has-no-review-state {
        text """
            Advocacy items, annotations, and briefs carry no review state. Review asks whether an extraction faithfully represents an original; an attorney's own analysis is not an extraction and there is nothing to check it against.
            """
    }
}

record evidence-intake-project.performance.read-path-optimization/1 : work {
    title "Optimize the kernel's read and write paths without changing what it stores"
    state completed
    scope [
        path "Cargo.toml",
        path "migrations/0006_read_paths.sql",
        path "src/main.rs",
        path "src/store.rs"
    ]
    intent """
        Remove repeated SQL compilation and per-row query fan-out from the store, stamp the schema version so an up-to-date database skips migration DDL on open, and index the read paths that were scanning. Nothing about what the kernel stores, refuses, or reports may change.
        """
    claim cached-statements {
        text """
            Every query goes through prepare_cached rather than prepare, with a statement cache sized above the module's distinct query count, so a read model never recompiles the same SQL once per row.
            """
    }
    claim no-per-row-queries {
        text """
            export_case, offense_comparison, issue_workspaces and witness_dossier read their material in a fixed number of statements instead of one query per proposition, charge, element or issue.
            """
    }
    claim partial-review-indexes {
        text """
            The review-queue indexes are partial on the two intake states, so they hold the work queue and nothing else, and shrink as a case is reviewed rather than growing.
            """
    }
    claim version-stamped-migrations {
        text """
            PRAGMA user_version records SCHEMA_VERSION so an already-current database skips the migration DDL on open. Migrations stay additive and re-runnable because any database at a lower version -- including zero, which is every database written before the stamp -- runs all of them.
            """
    }
}

record evidence-intake-project.workspace.source-linked-export/1 : work {
    title "Audience-aware source-linked export"
    state completed
    scope [
        path "docs/export.md",
        path "src/export.rs",
        path "src/main.rs",
        path "src/store.rs",
        path "tests/export.rs"
    ]
    intent """
        Build the last unbuilt item of Phase C in collation-first-plan.md: source-linked exports. Two domain rules were written about export before anything could produce one — rule 10 (privileged material excluded from routine exports) and rule 12 (every factual sentence resolves to a proposition or content node and from there to an exact original locator) — and nothing enforced either.
        """
    claim locators-checked-not-assumed {
        text """
            Rule 12 is verified while the export is assembled: an evidence item reaching the export with an empty locator fails the whole export rather than travelling as a fact nobody can open. A proposition resolving to no source-grounded evidence is listed as unsupported rather than exported as a bare assertion. Only content resolves to an original, so a proposition supported solely by another proposition or an event is correctly reported as unsupported.
            """
    }
    claim no-silent-omission-or-inclusion {
        text """
            The header carries `rejected_evidence_omitted` and `unreviewed_evidence_included`. Machine suggestions are exported with their state attached rather than hidden — hiding them would misrepresent the file — but a defender deciding whether to attach the export to a filing should not have to tally them by hand.
            """
    }
    claim privilege-excluded-structurally {
        text """
            A disclosable export never reads the advocacy, annotation, or brief tables at all. Exclusion is structural rather than a filter on the `privileged` flag, because a flag is only as good as every future writer that sets it and the cost of one wrong write is disclosing work product. The test proves it with a canary phrase that exists only inside privileged records and must appear nowhere in the serialized disclosable export.
            """
    }
    claim safe-default-audience {
        text """
            The CLI defaults to `disclosable`. The audience that cannot leak is the one produced by forgetting to choose.
            """
    }
}

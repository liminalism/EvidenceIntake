record evidence-intake-project.collation.time-location-index/1 : work {
    title "Collate evidence by normalized date and exact location without inferring a common event"
    state superseded
    scope [
        path "docs/**",
        path "src/lib.rs",
        path "src/main.rs",
        path "src/store.rs",
        path "src/views.rs",
        path "tests/collation.rs"
    ]
    intent """
        Add a case-level read model that preserves each original locator, raw and normalized time basis, and location text; groups active evidence chronologically by normalized date and by conservative exact location text; and identifies only multi-source date-plus-location groups as possibly related, with a written structural rationale, no score, no merge, no stored relationship and no event conclusion.
        """
    acceptance {
        check case-isolation {
            statement """
                The view returns only records from the requested case and refuses an unknown case.
                """
            method command
            command "cargo test --test collation"
        }
        check explainable-groups {
            statement """
                A possible group requires at least two distinct sources sharing an exact normalized date and conservative exact location key, states that reason, and neither scores nor asserts a common event.
                """
            method command
            command "cargo test --test collation"
        }
        check operator-surface {
            statement """
                The CLI exposes the collation read model as a case view and documentation explains its conservative boundary.
                """
            method command
            command "cargo test --all-targets"
        }
        check preserves-anchors {
            statement """
                The collation view preserves source identity, locator, raw/asserted/normalized times, time basis, location text, review state and machine provenance for each entry.
                """
            method command
            command "cargo test --test collation"
        }
        check quality {
            statement """
                Workspace tests, strict clippy and formatting pass.
                """
            method command
            command "cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all -- --check"
        }
    }
    implements [
        @evidence-intake-project.decision.not-a-case-management-system/1,
        @evidence-intake-project.decision.structure-not-verdict/1
    ]
    author "GitHub Uploader"
}


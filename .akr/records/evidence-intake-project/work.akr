}

record evidence-intake-project.video.keyframe-embedding-retrieval/1 : work {
    title "Text-to-frame retrieval over scene keyframes as the visual finder, instead of more detector classes"
    state completed
    intent """
        Embed each scene keyframe once with a CLIP/SigLIP-class image encoder behind the VisionBackend-style trait (JSON backend for tests, local CLI or ONNX for overnight runs) and store the vector against the derived still, so a lawyer can later ask for frames matching "person on the ground", "handcuffs", "firearm", "vehicle interior at night" without the adapter having predicted the class. A query returns SearchHit-style locators (original hash, time range, still) ordered by identifier within a similarity cut, never a similarity number, and every hit is a suggestion a person looks at; recall is preferred over precision because a false positive costs one look and a false negative hides evidence. Retrieval never writes an observation or an edge; only what a reviewer confirms is authored. Vectors are stored per case in SQLite (a blob column or the sqlite-vec extension), never shared across cases, and excluded from every export.
        """
    note """
        Optional overnight slice; preferred over widening the closed-set YOLO detector, whose COCO classes lack a gun and which must be fine-tuned per class. Storage is a BLOB plus brute-force cosine, not sqlite-vec: N is one vector per scene, in-memory tests and the Windows GUI cannot depend on load_extension, and export exclusion is structural only if export_case never queries the table. The cosine cut (0.20) and the JSON/CLI backends were settled on synthetic unit vectors; no live CLIP/SigLIP encoder was run against discovery footage.
        """
    acceptance {
        check case-local {
            statement """
                One case's stills never surface in another's visual search.
                """
            method command
            command "cargo test --test keyframes keyframe_search_is_scoped_to_its_case"
            verified_by [ @evidence-intake-project.evidence.keyframe-case-local/1 ]
        }
        check derived-only {
            statement """
                A source that is not a derived still cannot be indexed.
                """
            method command
            command "cargo test --test keyframes a_source_that_is_not_a_derived_still_is_refused"
            verified_by [ @evidence-intake-project.evidence.keyframe-derived-only/1 ]
        }
        check identifier-order {
            statement """
                Hits that meet the cut are ordered by still identifier, not by similarity.
                """
            method command
            command "cargo test --test keyframes hits_are_ordered_by_identifier_not_similarity"
            verified_by [ @evidence-intake-project.evidence.keyframe-identifier-order/1 ]
        }
        check json-backend {
            statement """
                JSON embeddings address the same still source ids scenes_to_batch uses.
                """
            method command
            command "cargo test -p evidence-video embed_keyframes_names_the_still_source_ids"
            verified_by [ @evidence-intake-project.evidence.keyframe-json-backend/1 ]
        }
        check locator {
            statement """
                A matching query returns the original hash and the still's locator on that original.
                """
            method command
            command "cargo test --test keyframes a_matching_query_returns_the_original_hash_and_locator"
            verified_by [ @evidence-intake-project.evidence.keyframe-locator/1 ]
        }
        check never-exported {
            statement """
                Neither disclosable nor work-file export carries embedding metadata.
                """
            method command
            command "cargo test --test keyframes export_never_carries_keyframe_vectors"
            verified_by [ @evidence-intake-project.evidence.keyframe-never-exported/1 ]
        }
        check no-score {
            statement """
                A serialized keyframe hit contains no similarity, score, cosine, rank or confidence field.
                """
            method command
            command "cargo test --test keyframes nothing_in_the_hit_reports_a_similarity_number"
            verified_by [ @evidence-intake-project.evidence.keyframe-no-score/1 ]
        }
        check silent-index {
            statement """
                Indexing writes no observation and no edge.
                """
            method command
            command "cargo test --test keyframes indexing_writes_no_observation_and_no_edge"
            verified_by [ @evidence-intake-project.evidence.keyframe-silent-index/1 ]
        }
        check workspace-gate {
            statement """
                fmt, clippy and the workspace test suite are green after the slice.
                """
            method command
            command "cargo test --workspace --all-features"
            verified_by [ @evidence-intake-project.evidence.keyframe-workspace-gate/1 ]
        }
    }
    after [
        @evidence-intake-project.video.audio-track-through-audio-adapter,
        @evidence-intake-project.video.clock-overlay-ocr
    ]
    depends_on [ @evidence-intake-project.video.scene-core ]
    implements [
        @evidence-intake-project.decision.keyframe-finder-is-an-index,
        @evidence-intake-project.decision.video-intake-points-never-asserts
    ]
}

record evidence-intake-project.video.real-embedding-benchmark/1 : work {
    title "Choose the visual finder model by local body-camera retrieval recall"
    state proposed
    scope [ path "adapters/video/**" ]
    intent """
        Implement the existing embed-cli contract with a fully local text-image encoder and compare real models on human-labeled original-timeline intervals from representative body-camera footage. Measure the sampler's opportunity to see each interval separately from the encoder's ability to retrieve it. Select and pin one exact model revision, preprocessing contract, embedding dimension and local runtime only after measuring interval recall, later-timeline coverage, indexing throughput, query latency and GPU memory on this workstation. Product hits remain unscored suggestions pointing to the original.
        """
    note """
        Start with Apache-2.0 Google SigLIP 2 base checkpoints that fit the RTX 4060 Laptop GPU: FixRes 384 as the primary candidate and NaFlex base as the aspect-ratio challenger. Do not download a detector or caption-generating VLM for this benchmark; closed-set boxes and generated prose answer different questions.
        """
    acceptance {
        check human-ground-truth {
            statement """
                A human-authored benchmark names original-timeline intervals for visible-state, setting, small-or-occluded-object, low-light, negative, and deliberately temporal/action queries without using any candidate model to label relevance.
                """
            method observation
        }
        check load-once-batch {
            statement """
                An indexing job loads the model once and embeds stills in batches or over a persistent stream; it does not start a model-loading process once per still.
                """
            method observation
            verified_by [
                @evidence-intake-project.video.evidence.siglip-load-once-batch-20260820/1
            ]
        }
        check local-cli {
            statement """
                A local executable satisfies the embedding backend contract, returns finite same-dimension vectors, records an immutable model identifier, and can run after model files are cached with network access disabled.
                """
            method command
            command "cargo test -p evidence-video live_embedding_cli_contract"
        }
        check operational-profile {
            statement """
                Each candidate records pinned model revision and license, disk download size, vector dimension, indexing frames per second, peak GPU memory, CPU fallback behavior, query latency and 100-hour vector/still storage projection on this workstation.
                """
            method observation
        }
        check selection {
            statement """
                The selected model and preprocessing are justified by interval recall and operational fit; the synthetic 0.20 cosine cut is either recalibrated from the benchmark or explicitly replaced, without exposing similarity values in product output.
                """
            method observation
        }
        check separate-recall {
            statement """
                The benchmark reports sampling opportunity/ceiling separately from retrieval recall at the reviewer's result budget, so a missed frame is not misattributed to the encoder.
                """
            method observation
        }
    }
    depends_on [
        @evidence-intake-project.video.bounded-coverage-keyframes/1,
        @evidence-intake-project.video.keyframe-embedding-retrieval/1
    ]
    implements [
        @evidence-intake-project.decision.keyframe-finder-is-an-index/1,
        @evidence-intake-project.decision.video-intake-points-never-asserts/1
    ]
}

record evidence-intake-project.video.scene-captions/1 : work {
    title "VLM scene descriptions as suggested observations"
    state completed
    intent """
        Add an optional VLM pass: one suggested scene description per keyframe.
        Captions enter as observations on the original video timeline, never as
        facts, never verified, never naming a person. JSON is the test path; a
        local CLI (ollama-class) is the overnight path.
        """
    acceptance {
        check cannot-verify {
            statement """
                Machine scene descriptions cannot arrive verified.
                """
            method command
            command "cargo test -p evidence-video machine_descriptions_cannot_arrive_verified"
            verified_by [ @evidence-intake-project.evidence.video-captions-cannot-verify/1 ]
        }
        check caption-observation {
            statement """
                A scene description is a suggested observation on the original
                timeline and does not claim what happened.
                """
            method command
            command "cargo test -p evidence-video a_scene_description_is_an_observation_not_a_finding"
            verified_by [ @evidence-intake-project.evidence.video-caption-is-observation/1 ]
        }
        check json-backend {
            statement """
                JSON captions attach to the video source and import.
                """
            method command
            command "cargo test -p evidence-video json_descriptions_attach_to_the_video_source"
            verified_by [ @evidence-intake-project.evidence.video-json-captions-attach/1 ]
        }
    }
    depends_on [
        @evidence-intake-project.video.no-forensic-assertions,
        @evidence-intake-project.video.scene-core
    ]
    implements [ @evidence-intake-project.decision.video-intake-points-never-asserts ]
}

record evidence-intake-project.video.scene-core/1 : work {
    title "Video scene-cut core before any vision model"
    state completed
    intent """
        Build the video intake core before any vision model: hash the original
        container, detect scene cuts with ffmpeg, extract a keyframe still per
        scene as a derived source, and emit a NormalizedBatch of suggested
        observations (and recording_gap on a claimed-duration dropout). Locators
        address the original timeline in the same shape as the hit-and-run camera
        fixture. No neural net.
        """
    acceptance {
        check derived-stills {
            statement """
                A keyframe still is imported as its own derived source and is not
                substituted for the original video hash.
                """
            method command
            command "cargo test -p evidence-video a_keyframe_is_a_derived_source_not_the_original"
            verified_by [ @evidence-intake-project.evidence.video-keyframe-derived-source/1 ]
        }
        check dropout-gap {
            statement """
                A tail shorter than the container's claimed duration becomes a
                recording_gap.
                """
            method command
            command "cargo test -p evidence-video a_tail_shorter_than_claimed_duration_is_a_recording_gap"
            verified_by [ @evidence-intake-project.evidence.video-dropout-gap/1 ]
        }
        check mapper-scenes {
            statement """
                Hand-built scene cuts map to suggested observations whose locators
                match the fixture clock style and import as SourceKind::Video.
                """
            method command
            command "cargo test -p evidence-video a_scene_observation_enters_suggested_on_the_original_timeline"
            verified_by [
                @evidence-intake-project.evidence.video-scene-suggested-on-timeline/1
            ]
        }
    }
    implements [ @evidence-intake-project.decision.video-intake-points-never-asserts ]
}

record evidence-intake-project.workspace.source-linked-export/1 : work {
    title "Audience-aware source-linked export"
    state completed
    scope [
        path "docs/export.md",
        path "src/export.rs",
        path "src/main.rs",
        path "src/store.rs",
        path "tests/export.rs"
    ]
    intent """
        Build the last unbuilt item of Phase C in collation-first-plan.md: source-linked exports. Two domain rules were written about export before anything could produce one — rule 10 (privileged material excluded from routine exports) and rule 12 (every factual sentence resolves to a proposition or content node and from there to an exact original locator) — and nothing enforced either.
        """
    claim locators-checked-not-assumed {
        text """
            Rule 12 is verified while the export is assembled: an evidence item reaching the export with an empty locator fails the whole export rather than travelling as a fact nobody can open. A proposition resolving to no source-grounded evidence is listed as unsupported rather than exported as a bare assertion. Only content resolves to an original, so a proposition supported solely by another proposition or an event is correctly reported as unsupported.
            """
    }
    claim no-silent-omission-or-inclusion {
        text """
            The header carries `rejected_evidence_omitted` and `unreviewed_evidence_included`. Machine suggestions are exported with their state attached rather than hidden — hiding them would misrepresent the file — but a defender deciding whether to attach the export to a filing should not have to tally them by hand.
            """
    }
    claim privilege-excluded-structurally {
        text """
            A disclosable export never reads the advocacy, annotation, or brief tables at all. Exclusion is structural rather than a filter on the `privileged` flag, because a flag is only as good as every future writer that sets it and the cost of one wrong write is disclosing work product. The test proves it with a canary phrase that exists only inside privileged records and must appear nowhere in the serialized disclosable export.
            """
    }
    claim safe-default-audience {
        text """
            The CLI defaults to `disclosable`. The audience that cannot leak is the one produced by forgetting to choose.
            """
    }
}

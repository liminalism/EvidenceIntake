akr 0.1
project evidence-intake-project

record evidence-intake-project.constraint.distinct-alt-keys/1 : constraint {
    title "Every command in the WinSafe window claims a distinct Alt key"
    state proposed
    scope [ path "path src/gui/winsafe.rs" ]
    topic gui-keyboard
    statement """
        No two controls in the WinSafe main window may claim the same mnemonic letter. Win32 resolves a mnemonic across the whole window, so a repeated letter makes Alt cycle focus between the claimants instead of pressing either one -- which silently breaks the keyboard path the status bar advertises, without any visible symptom. Command captions therefore live as named constants at the top of src/gui/winsafe.rs, and the unit test every_command_has_its_own_alt_key is what keeps them distinct.
        """
    claim labels-claim-mnemonics-too {
        text """
            A static label takes the same ampersand prefix as a button, so a heading may not contain a bare ampersand. The heading 'COLLATION & EXPORT' would have claimed Alt+Space, which is the system menu.
            """
    }
    claim what-the-collisions-were {
        text """
            Before this pass four commands claimed Alt+V -- Seed Vehicle, Save Export, Reviewed and Verify -- and further pairs collided on O, R, T, S and I. Fixing them forced several captions to change: the import command became 'Import Normalized Batch' and the authoring command became 'Save New Record', both of which are also more accurate than what they replaced.
            """
    }
}

record evidence-intake-project.constraint.window-fits-the-screen/1 : constraint {
    title "The DPI-scaled window is clamped to the screen and floored at a size the layout survives"
    state proposed
    scope [ path "path src/gui/winsafe.rs" ]
    topic gui-sizing
    statement """
        The WinSafe layout is written in logical units and gui::dpi scales every coordinate by the system DPI, so the window grows with the user's display scaling: the 1100x700 design size wants 1650x1050 device pixels at 150% and 2200x1400 at 200%. Windows will create a window larger than the screen, which puts the bottom command row past the edge with no way to reach it, so fit_to_work_area shrinks the window onto the monitor's work area at WM_CREATE. It never shrinks below the layout's floor of 940x600 logical, which WM_GETMINMAXINFO also enforces as the minimum tracking size: a window that overflows can still be moved to reach the rest of it, whereas one shrunk past the floor has commands that overlap and cannot be separated again.
        """
    claim labels-shrink-rather-than-collide {
        text """
            A label whose right edge would run under a right-anchored control is given Horz::Resize rather than a fixed width, so the gap between them is preserved as the window narrows. Every label carries SS_ENDELLIPSIS so the text it loses ends in an ellipsis instead of a stroke cut mid-glyph.
            """
    }
    claim the-bottom-row-sets-the-width-floor {
        text """
            MIN_WIDTH is set by the bottom command row: Reject ends at a fixed logical 592 while the authoring pair is right-anchored and slides left as the window narrows, so the two collide once the window loses about 190 logical units.
            """
    }
    claim the-rail-sets-the-height-floor {
        text """
            MIN_HEIGHT is set by the navigation rail, not by the output pane. The rail is anchored and does not move on resize, so its last button's lower edge at logical 578 is the floor; a height derived from the output pane instead was measured at 470 and hid the four collation and export commands off the bottom of the window.
            """
    }
}

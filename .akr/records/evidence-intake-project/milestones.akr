akr 0.1
project evidence-intake-project

record evidence-intake-project.assembly.case-assembly/1 : milestone {
    title "Case assembly: the missing middle between extraction and digest"
    state proposed
    scope [
        path "adapters/**",
        path "docs/case-assembly-plan.md",
        path "fixtures/**",
        path "migrations/**",
        path "src/**",
        path "tests/**"
    ]
    intent """
        Build the layer the external review found missing: reviewed, append-only semantic interpretation over immutable content; descriptive provenance edges and lineage; occurrence candidates; proposition packets as the primary workspace; and a deterministic, template-rendered, source-linked layered digest. The binding constraint is manual entry: most semantic fields cannot be detected without a language model, which the project declines, so the enrichment workflow is designed around a measured keystroke budget (inherit from a source profile, sweep one field across passages, one key to accept or refuse a deterministic candidate). No scoring, no merging, no occurrence or independence declared by a machine. The full plan is docs/case-assembly-plan.md.
        """
    note """
        Origin: AKR source collation-gap-review-2026-08-23. Resolves the open append-to-identical-source question (one immutable original, many append-only passes) when the interpretation schema lands; the soundtrack PTS-offset question blocks only the synchronized audio/video view.
        """
    acceptance {
        check honest-views {
            statement """
                The time/place index and the analyzer button are renamed, every displayed time carries its semantic label with 'Alignment: not set' where unset, every rendered passage carries a provenance badge, no-speech intervals are never recording_gap, and no count is labelled as sources or corroboration.
                """
            method command
            command "cargo test --all-features --test collation"
        }
        check keystroke-budget {
            statement """
                The scripted enrichment harness classifies every material passage of the raw-file report fixture (form, speaker, stance) in at most 1.6 keystrokes per passage, with reporting parents and attributed persons in at most 4 each, through the Workspace API alone.
                """
            method command
            command "cargo test --all-features --test enrichment"
        }
        check no-machine-conclusions {
            statement """
                Zero occurrence declarations exist without a reviewed candidate_same_occurrence or account_of edge; zero independently_corroborates edges exist between nodes sharing a lineage; the packet and digest views pass the no-scoring-vocabulary serialization test.
                """
            method command
            command "cargo test --all-features --test assembly"
        }
        check raw-file-workflow {
            statement """
                The hit-and-run proposition packets and digest are produced from synthetic raw files through the real adapters, an InterpretationBatch and the authoring API, with no SQL seeding, and every adversarial scenario in the plan's section 9 has a passing test.
                """
            method command
            command "cargo test --all-features --test assembly"
        }
        check source-linked-digest {
            statement """
                A saved digest contains zero factual sentences without an exact locator, validate_digest refuses any other digest, a factual brief paragraph without references is refused, and the disclosable audience never reads the privileged tables.
                """
            method command
            command "cargo test --all-features --test export"
        }
        check workspace-green {
            statement """
                cargo fmt --check, clippy with warnings denied over all targets and features, and the full test suite pass; debug-release and release-final profiles build.
                """
            method command
            command "cargo clippy --all-targets --all-features -- -D warnings && cargo test --all-features"
        }
    }
    depends_on [
        @evidence-intake-project.decision.adapters-may-propose-structural-edges,
        @evidence-intake-project.decision.structure-not-verdict
    ]
    source {
        kind external
        role origin
        document "collation-gap-review-2026-08-23"
        start_byte 27821
        end_byte 28834
        start_line 817
        end_line 827
        excerpt_hash "sha256:553491f848543e652e3a474a258d43f9d8658866dca3c7c6720e244e4216b5bf"
        use """
            The diagnosis of the missing middle and the order of the five stages.
            """
    }
    source {
        kind external
        role constraint
        document "collation-gap-review-2026-08-23"
        start_byte 26794
        end_byte 27820
        start_line 803
        end_line 815
        excerpt_hash "sha256:c0cf73f85cd789ec1bf9f5056d5b2af1eb7447f93cca46f8ee1e9561a46ee40d"
        use """
            The acceptance criteria, adopted verbatim as the milestone checks.
            """
    }
}

record evidence-intake-project.inference.universal-tensorrt-integration/1 : milestone {
    title "Document intake and universal TensorRT runtime"
    state active
    scope [ path "Cargo.toml", path "adapters/**", path "runtime/**", path "scripts/**" ]
    intent """
        Wire PDF document processing into Evidence Intake, then replace every live GPU-model backend with an Evidence-owned Windows NVIDIA inference broker using TensorRT or TensorRT-LLM.
        """
    acceptance {
        check document-intake {
            statement """
                The evidence-document CLI maps packaged Lege DocIR raw text regions into an importable NormalizedBatch while retaining artifacts.
                """
            method command
        }
        check model-migrations {
            statement """
                OCR, SigLIP, YOLO, Whisper, and Qwen use the broker and superseded live Evidence inference backends are removed after parity tests.
                """
            method command
        }
        check runtime-broker {
            statement """
                A versioned fail-closed local broker supervises typed TensorRT and TensorRT-LLM inference operations with model provenance and bounded residency.
                """
            method command
        }
        check windows-doctor {
            statement """
                The Windows NVIDIA package doctor validates installed model manifests and executes a real probe for every installed model.
                """
            method command
        }
        check workspace-tests {
            statement """
                Workspace tests and static checks pass.
                """
            method command
        }
    }
}

record evidence-intake-project.office.court-office-foundation/1 : milestone {
    title "Office layer foundation: clients, matters, calendar, and the Court/Office workspace"
    state completed
    scope [
        path "docs/office-layer-plan.md",
        path "migrations/**",
        path "office-core/**",
        path "src/**"
    ]
    intent """
        Wrap the evidence kernel in the first slice of the public-defender office layer: an office-core crate with its own store (users, clients, matters, assignments, courts, appearances, deadlines, notes), the optional matter-to-evidence-case link, office-wide search with conservative conflict prompts, and the WinSafe GUI reorganized into a calendar-first Court pane and an Office pane hosting the existing intake and review surfaces. Corresponds to CMS-0 plus the calendar/docket core of CMS-1 in docs/office-layer-plan.md; reporting builder, custom fields, timekeeping, multi-user server, PWA and communications are later milestones.
        """
    note """
        Local-first, single-machine, SQLite. Schema written for eventual PostgreSQL portability behind evidence-server, but no server, RBAC or sync in this milestone. GUI work happens in Windows sessions; schema, stores, read models and CLI are buildable on Linux.
        """
    acceptance {
        check conservative-identity {
            statement """
                No client or person record is merged with, or linked to, an evidence entity automatically; the GUI only surfaces possible-match prompts that a named person resolves, and declining leaves both records untouched.
                """
            method manual
            verified_by [ @evidence-intake-project.evidence.conservative-identity-20260830/1 ]
        }
        check docket-first {
            statement """
                From the Court pane alone, an attorney can answer what they must do today and tomorrow — client, matter, setting time and type, custody state, deadlines, evidence posture, open work — without opening another program or the Office pane.
                """
            method manual
            verified_by [ @evidence-intake-project.evidence.docket-first-court-pane-20260830/1 ]
        }
        check immutable-note-authorship {
            statement """
                An office note records its author and time immutably; editing produces a visible revision that supersedes rather than overwrites, and no user can silently alter another author's note.
                """
            method manual
            verified_by [
                @evidence-intake-project.evidence.immutable-note-authorship-20260830/1
            ]
        }
        check kernel-unchanged {
            statement """
                The evidence kernel schema and its invariant tests are untouched by the office layer, and the full suite passes with office-core in the workspace.
                """
            method command
            command "cargo test --all-features"
            verified_by [
                @evidence-intake-project.evidence.kernel-unchanged-with-office-20260830/1
            ]
        }
        check one-appearance-many-matters {
            statement """
                A single court appearance links every related matter of one client; the docket renders one row for it, not one per matter; a linked matter can be individually removed or overridden.
                """
            method manual
            verified_by [
                @evidence-intake-project.evidence.one-appearance-many-matters-20260830/1
            ]
        }
        check privileged-boundary {
            statement """
                Advocacy items, annotations and decision briefs cannot be read through the office database, any office read model, or any office export.
                """
            method manual
            verified_by [
                @evidence-intake-project.evidence.office-privileged-boundary-20260830/1
            ]
        }
    }
    depends_on [ @evidence-intake-project.decision.office-layer-around-the-kernel ]
    source {
        kind external
        role rationale
        document "defenderdata-cms-expansion-review-2026-08-30"
        path "sources/external/defenderdata-cms-expansion-review-2026-08-30--d312bcf5.md"
        use """
            Milestone slicing follows the review's CMS-0/CMS-1 ordering with calendar pulled forward per the owner's calendar-first direction; the docket-first gate adapts the review's 150-misdemeanor test.
            """
    }
}

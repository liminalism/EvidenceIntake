record evidence-intake-project.evidence.gui-platform-boundary-after-chrome-pass/1 : evidence {
    title "Default build carries no Win32 dependency after the layout and chrome pass"
    state verified
    result pass
    method command
    observed_at git:f807e4656fc87aeaa071e01145cf3ebae831b03c
    command "cargo check --all-targets"
    summary """
        cargo check --all-targets finished clean on the default feature set, and `cargo tree -e normal` lists winsafe zero times, so the Win32 dependency remains reachable only through the optional gui-winsafe feature and its cfg(windows) target table. src/gui/mod.rs compiles without the feature; only the src/gui/winsafe.rs module and the evidence-gui binary are gated behind it.
        """
}

record evidence-intake-project.evidence.gui-winsafe-build-after-chrome-pass/1 : evidence {
    title "The gui-winsafe feature builds and its tests pass after the layout and chrome pass"
    state verified
    result pass
    method command
    observed_at git:f807e4656fc87aeaa071e01145cf3ebae831b03c
    command "cargo test --features gui-winsafe"
    summary """
        cargo test --features gui-winsafe passed 110 tests across all targets with no failures. The library target now carries 11 rather than 10, the addition being every_command_has_its_own_alt_key, which walks every command caption constant and fails if two claim the same mnemonic letter. cargo fmt --check and cargo clippy --all-targets --all-features -- -D warnings were also clean.
        """
}


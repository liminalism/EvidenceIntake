record evidence-intake-project.video.sample-scene-coverage-gap/1 : observation {
    title "Scene-only sampling leaves long unrepresented spans in the local video sample"
    state superseded
    scope [ path "adapters/video/**", path "evidence-examples/**" ]
    statement """
        Against the current local 18:34.986 H.264 sample, ffmpeg scene scoring at the adapter default 0.30 threshold produced 57 cuts (58 scenes). The median interval was 8.74 seconds, 15 intervals exceeded 30 seconds, 6 exceeded 60 seconds, and the maximum was 76.94 seconds. Because the adapter extracts only the frame at each scene start, the visual finder cannot retrieve anything visible only between those sampled instants.
        """
    observed_at git:0a17a5d442e4980045b2c220208df090f77a937f
    method command
    watches [ "adapters/video/src/scene.rs", "evidence-examples/*.mp4" ]
    derived_from [ @evidence-intake-project.video.scene-core/1 ]
    author "GitHub Uploader"
}


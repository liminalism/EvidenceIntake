record evidence-intake-project.video.qwen2-vl-donetsk-caption-smoke/1 : observation {
    title "Pinned Qwen2-VL produces a fast complete skim index but needs conservative display validation"
    state superseded
    statement """
        The replacement evidence sample jaf69w.mp4 (SHA-256 E92C56F7BD9E53B98866D1D79BC61358F0257C62409E29477D3A23D751B41140) fully decoded as 13:54.781 of 1280x720 H.264 at 25 fps with AAC audio. In an isolated Transformers 5.7.0 environment sharing torch 2.13.0+cu132, the Apache-2.0 Qwen/Qwen2-VL-2B-Instruct checkpoint pinned at 895c3a49bc3fa70a340399125c650a463535e71c loaded from two verified local weight shards totaling 4.13 GiB. A four-frame joint first-two-minute smoke completed in 44.6 seconds but peaked at 7469.5 MiB CUDA allocation on the 8 GiB RTX 4060. Keeping the model resident and captioning 24 frames independently at five-second intervals completed in 75.998 seconds (3.17 seconds/frame), peaked at 4568.8 MiB, and returned non-empty plain navigation text for every frame with no malformed-response leakage. The captions usefully located the reporter view, street, emergency vehicles, stretcher, smoke and hoses. Visual audit also established the epistemic boundary: 'military personnel' at about 00:42 was a plausible contextual inference from two people in camouflage uniforms, while an earlier 'possibly a protest or riot' phrase was unsupported by the sampled frame. The display caption should therefore preserve directly visible wording such as 'people in camouflage clothing'; broader queries such as 'military personnel' may still retrieve that frame through embeddings. Qwen2-VL is promising for a suggested skim index when run one frame at a time with a load-once runtime, pinned offline files, output validation and human review, but its free text must never be treated as a factual observation.
        """
    observed_at git:0a17a5d442e4980045b2c220208df090f77a937f
    method command
    watches [ "adapters/video/**" ]
    depends_on [ @evidence-intake-project.decision.video-intake-points-never-asserts/1 ]
    derived_from [ @evidence-intake-project.video.real-embedding-benchmark/1 ]
    author "GitHub Uploader"
    source {
        kind external
        role evidence
        url "https://huggingface.co/Qwen/Qwen2-VL-2B-Instruct/tree/895c3a49bc3fa70a340399125c650a463535e71c"
        use """
            Pinned model artifact, model size and Apache-2.0 licensing.
            """
    }
    source {
        kind internal
        role evidence
        path ".agent/scratch/donetsk-jaf69w/first-2m-qwen-captions-v2.json"
        use """
            Load-once 24-frame first-two-minute caption report.
            """
    }
    source {
        kind internal
        role evidence
        path ".agent/scratch/donetsk-jaf69w/qwen2-vl-smoke.jsonl"
        use """
            Four-frame joint smoke latency and CUDA peak-memory report.
            """
    }
}

record evidence-intake-project.video.qwen2-vl-donetsk-caption-smoke/2 : observation {
    title "Pinned Qwen2-VL supports a conservative load-once visual skim index"
    state superseded
    statement """
        The replacement evidence sample jaf69w.mp4 (SHA-256 E92C56F7BD9E53B98866D1D79BC61358F0257C62409E29477D3A23D751B41140) fully decoded as 13:54.781 of 1280x720 H.264 at 25 fps with AAC audio. In an isolated Transformers 5.7.0 environment sharing torch 2.13.0+cu132, the Apache-2.0 Qwen/Qwen2-VL-2B-Instruct checkpoint pinned at 895c3a49bc3fa70a340399125c650a463535e71c loaded from two verified local weight shards totaling 4.13 GiB. A four-frame joint request completed in 44.6 seconds but peaked at 7469.5 MiB CUDA allocation on the 8 GiB RTX 4060; keeping the model resident and captioning 24 frames independently completed in 75.998 seconds and peaked at 4568.8 MiB. The integrated project-owned Rust-to-Python batch backend then processed 26 scene windows across the first 02:00.040 in one load-once process. It stored 26 suggested observations using only a deterministic bounded visible-feature vocabulary, stamped every caption with the pinned model revision, retained no free-form model prose, and produced zero matches for military, police, officer, firefighter, patient, riot, protest, attack, explosion, guilty or innocent. The 00:39.480-00:44.480 window is indexed as multiple people, camouflage clothing, vehicle, building and road, preserving directly visible appearance without assigning a military role. The adapter supports explicit null abstention, although this sample produced none. Qwen2-VL is therefore usable as a suggested visual skim index when run sequentially with a resident offline model, deterministic output reduction and human review; it is not a factual narrator and must not provide identity, role, event or legal conclusions.
        """
    observed_at git:0a17a5d442e4980045b2c220208df090f77a937f
    method command
    watches [ "adapters/video/**" ]
    depends_on [ @evidence-intake-project.decision.video-intake-points-never-asserts/1 ]
    derived_from [ @evidence-intake-project.video.real-embedding-benchmark/1 ]
    supersedes [ @evidence-intake-project.video.qwen2-vl-donetsk-caption-smoke/1 ]
    author "GitHub Uploader"
    source {
        kind external
        role evidence
        url "https://huggingface.co/Qwen/Qwen2-VL-2B-Instruct/tree/895c3a49bc3fa70a340399125c650a463535e71c"
        use """
            Pinned model artifact, model size and Apache-2.0 licensing.
            """
    }
    source {
        kind internal
        role evidence
        path ".agent/scratch/donetsk-jaf69w/first-2m-qwen-captions-v2.json"
        use """
            Load-once 24-frame exploratory caption report.
            """
    }
    source {
        kind internal
        role evidence
        path ".agent/scratch/donetsk-jaf69w/integrated-qwen-final/batch.json"
        use """
            Integrated Rust/Python 26-window normalized caption batch for the first two-minute working copy.
            """
    }
    source {
        kind internal
        role evidence
        path ".agent/scratch/donetsk-jaf69w/qwen2-vl-smoke.jsonl"
        use """
            Four-frame joint smoke latency and CUDA peak-memory report.
            """
    }
}


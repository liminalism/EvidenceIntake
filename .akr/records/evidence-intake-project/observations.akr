akr 0.1
project evidence-intake-project

record evidence-intake-project.inference.linux-tensorrt-ocr-build/1 : observation {
    title "Linux builds and runs the real TensorRT OCR path"
    state superseded
    scope [ path "adapters/document/**", path "runtime/tensorrt/**" ]
    statement """
        On the RTX 4060 Linux workstation, the TurboOCR lean CUDA/TensorRT text pipeline builds from source against TensorRT 11.0.0.114 and CUDA 13.3 when CMAKE_CUDA_COMPILER is supplied explicitly; its native TensorRT probe and the Evidence broker-to-real-OCR integration test both pass.
        """
    observed_at git:fc3212c7247aee4564d71eacd065a3d35d373de6
    method command
    watches [ "runtime/tensorrt/**", "adapters/document/**" ]
    verified_by [ @evidence-intake-project.evidence.linux-tensorrt-ocr-real-cuda/1 ]
}


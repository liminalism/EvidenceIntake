record evidence-intake-project.video.siglip2-cut-distribution/1 : observation {
    title "The synthetic 0.20 cosine cut returns no SigLIP 2 candidates on the local sample"
    state superseded
    scope [ path "adapters/video/**", path "src/store.rs", path "src/views.rs" ]
    statement """
        The local google/siglip2-base-patch16-384 checkpoint embedded 254 hybrid-sampled frames from the 18:34.986 local video into finite normalized 768-dimensional vectors. Across nine representative text queries, maximum cosine similarity ranged from 0.0766 to 0.1204 and zero frames met the synthetic KEYFRAME_SIMILARITY_CUT of 0.20. The fixed cut therefore makes the live visual finder return no candidates even though the model produces a usable relative ordering.
        """
    observed_at git:0a17a5d442e4980045b2c220208df090f77a937f
    method command
    watches [ "src/store.rs", "src/views.rs", "adapters/video/src/embed.rs" ]
    derived_from [ @evidence-intake-project.video.real-embedding-benchmark/1 ]
    author "GitHub Uploader"
}

